# Copy to .env at the repository root; never commit actual credentials.
# Start the backend using the root npm scripts so dotenv loads this directory.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Optional local defaults; register this exact callback in Spotify app settings.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/api/auth/callback
# Set explicitly: CORS and OAuth redirect fallback hostnames differ in code.
FRONTEND_URL=http://127.0.0.1:5173
# Keep 3001 locally: Vite's API proxy targets this port.
PORT=3001
# Secure cookies are enabled only in production (HTTPS required).
NODE_ENV=development
